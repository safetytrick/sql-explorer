DB_HOST=your-db-host.example.com
SSH_URL=your.user@your-bastion.example.com

# The compose files that make up your stack, ':'-separated. docker compose reads
# this itself, and ./dev-restart.sh rebuilds and recreates against it (adding
# docker-compose.local-build.yml if it is missing). For example, with the dev IdP:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev-idp.yml:docker-compose.local-build.yml
