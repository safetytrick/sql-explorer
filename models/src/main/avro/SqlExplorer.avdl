
@namespace("com.github.safetytrick.sqlexplorer.avro")
protocol SqlExplorer {

	record SqlProfile {
		string id;
		string query;
		array<TableReference> tables = [];
		string type;
		array<JoinColumns> joinColumns = [];
		array<ColumnReference> criteriaColumns = [];
		array<ColumnReference> selectColumns = [];
		array<ColumnReference> groupByColumns = [];
		string? generatedSource = null;
		boolean truncated = false;
		boolean analysisFailed = false;
		boolean analysisSkipped = false;
		boolean isDml = false;
		RuntimeMetrics? runtimeMetrics;
		string digest;
		string normalizedDigest;
		string schemaName;
		array<string> schemas = [];
		array<JoinColumns> mismatchedJoins = [];
		int? lineNumber = null;
		string? analysisFailureReason = null;
		string? sourceFileName = null;
		array<string> sourcedFiles = [];
		QueryActivityStatus queryActivityStatus;
		boolean modifiedForAnalysis = false;
		boolean isMultiSchema = false;
		/** Repeated blocks collapsed by normalization; offsets index into query. */
		array<RepeatedBlock> repeatedBlocks = [];
		/** Profiles folded into this one by normalized-digest merging. */
		array<MergedChild> mergedChildren = [];
		/**
		 * Which version of the analysis produced this profile — the analyzers'
		 * version and the normalizer's together (AnalyzerVersion). A later load
		 * reuses this profile's analysis for the same digest and session schema
		 * only while this matches (sqlx-sqy.5). Null on profiles analysed before
		 * versions were recorded, which are therefore never reused.
		 */
		string? analyzerVersion = null;
		/**
		 * The row's own default schema as Performance Schema reported it, before
		 * any inference. Part of the reuse key: the same unqualified statement
		 * under two default schemas shares a MySQL digest but not its tables.
		 */
		string? sessionSchema = null;
	}

	/**
	 * One block the normalizer collapsed: the first kept instance sits at
	 * [start, end) in the profile's query text and occurred count times in
	 * the original sample.
	 */
	record RepeatedBlock {
		int start;
		int end;
		int count;
	}

	/**
	 * One profile folded into the representative by normalized-digest
	 * merging: its own MySQL digest, the repeats it collapsed, and the
	 * metrics it contributed. Every member of a merge group normalizes to
	 * the same text, so these offsets index into the representative's query
	 * the same way its own repeatedBlocks do — only the counts differ.
	 */
	record MergedChild {
		string digest;
		array<RepeatedBlock> repeatedBlocks = [];
		long executed;
		@java-class("java.math.BigDecimal") string averageTime;
	}

	enum QueryActivityStatus {
		ACTIVE, DORMANT, UNKNOWN
	}

	record RuntimeMetrics {
		boolean fullTableScan;
		long executed;
		long errors;
		long warnings;
		@java-class("java.math.BigDecimal") string totalTime;
		@java-class("java.math.BigDecimal") string maxTime;
		@java-class("java.math.BigDecimal") string averageTime;
		long rowsSent;
		long averageRowsSent;
		long rowsScanned;
		long averageRowsScanned;
		long tempTables;
		long tempDiskTables;
		long rowsSorted;
		long sortMergePasses;
		string digest;
		local_timestamp_ms lastSeen;
		local_timestamp_ms firstSeen;
		@java-class("java.math.BigDecimal") string lockTime;
		long rowsAffected;
		long averageRowsAffected;
		array<string> digestList = [];
	}

	record ColumnReference {
		TableReference table;
		string column;
		string normalizedColumn;
	}

	record JoinColumns {
		ColumnReference left;
		ColumnReference right;
		/** INNER/LEFT/RIGHT/FULL/CROSS/STRAIGHT/IMPLICIT; null when unknown. */
		string? joinType = null;
	}

	record TableReference {
		string? schemaName;
		string tableName;
		string normalizedTableName;
		string? normalizedSchemaName;
	}
}
