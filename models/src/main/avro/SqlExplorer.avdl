
@namespace("com.github.safetytrick.sqlexplorer.avro")
protocol SqlExplorer {

	record SqlProfile {
		string id;
		string query;
		array<TableReference> tables = [];
		string type;
		array<JoinColumns> joinColumns = [];
		array<ColumnReference> criteriaColumns = [];
		array<ColumnReference> selectColumns = [];
		array<ColumnReference> groupByColumns = [];
		string? generatedSource = null;
		boolean truncated = false;
		boolean analysisFailed = false;
		boolean analysisSkipped = false;
		boolean isDml = false;
		RuntimeMetrics? runtimeMetrics;
		string digest;
		string normalizedDigest;
		string schemaName;
		array<string> schemas = [];
		array<JoinColumns> mismatchedJoins = [];
		int? lineNumber = null;
		string? analysisFailureReason = null;
		string? sourceFileName = null;
		array<string> sourcedFiles = [];
		/**
		 * The sources the statement was captured from, by source ref — for a
		 * live source, the server's name. One per profile as loaded; a profile
		 * merged across sources holds each of theirs. Where it ran, not how
		 * much: per-source figures come from scoping the corpus to a source
		 * (SourceScope), not from this list (sqlx-a9h.1).
		 */
		array<string> sources = [];
		QueryActivityStatus queryActivityStatus;
		boolean modifiedForAnalysis = false;
		boolean isMultiSchema = false;
		/** Repeated blocks collapsed by normalization; offsets index into query. */
		array<RepeatedBlock> repeatedBlocks = [];
		/** Profiles folded into this one by normalized-digest merging. */
		array<MergedChild> mergedChildren = [];
		/**
		 * Which version of the analysis produced this profile — the analyzers'
		 * version and the normalizer's together (AnalyzerVersion). A later load
		 * reuses this profile's analysis for the same digest and session schema
		 * only while this matches (sqlx-sqy.5). Null on profiles analysed before
		 * versions were recorded, which are therefore never reused.
		 */
		string? analyzerVersion = null;
		/**
		 * The row's own default schema as Performance Schema reported it, before
		 * any inference. Part of the reuse key: the same unqualified statement
		 * under two default schemas shares a MySQL digest but not its tables.
		 */
		string? sessionSchema = null;
		/**
		 * The indexes the statement names in index hints, one entry per name:
		 * FROM t FORCE INDEX (a, b) is two (sqlx-yj0).
		 */
		array<IndexHint> indexHints = [];
		/**
		 * Columns the statement sorts by, through table and select-list
		 * aliases (sqlx-n5j.8).
		 */
		array<ColumnReference> orderByColumns = [];
		/**
		 * How the statement compares its criteria columns: one entry per
		 * distinct (column, kind, leadingWildcard). A qualifier on
		 * criteriaColumns, not a role of its own — every column here is a
		 * criteria column too. LIKE lives here (sqlx-n5j.7).
		 */
		array<CriteriaComparison> criteriaComparisons = [];
		/**
		 * Which generators' signatures the statement matches, one entry per
		 * matching rule (sqlx-n5j.12). CANDIDATES, not an origin: two generators
		 * can share a pattern, so a match only becomes an asserted origin once a
		 * person has confirmed the environment uses that generator, and that is
		 * applied when read rather than stored here. Supersedes generatedSource.
		 */
		array<GeneratorCandidate> generatorCandidates = [];
	}

	/**
	 * One way a WHERE clause compares one criteria column.
	 */
	record CriteriaComparison {
		ColumnReference column;
		/**
		 * equality (=, <=>), inequality (!=, <>), range (<, <=, >, >=,
		 * BETWEEN), in, not in, like, not like, null check (IS [NOT] NULL).
		 * Taken from the nearest comparison above the column, so
		 * LOWER(name) LIKE ? is a like on name. A criteria column under no
		 * such comparison (WHERE flag, the pattern side of a LIKE) has no
		 * entry.
		 */
		string kind;
		/**
		 * like / not like only: whether the pattern starts with a wildcard
		 * (% or _), which no index prefix can serve. Known only when the
		 * pattern literal survived into the analysed text; null — unknown —
		 * when it is a parameter (the usual case: a digest replaces every
		 * literal with ?) or any other expression.
		 */
		boolean? leadingWildcard = null;
	}

	/**
	 * One generator signature a statement matched: the generator (e.g.
	 * doctrine-orm, hibernate) and the rule within its set that matched.
	 */
	record GeneratorCandidate {
		string generator;
		string rule;
	}

	/**
	 * One index named by a MySQL index hint on one table.
	 */
	record IndexHint {
		TableReference table;
		/** As the statement wrote it. */
		string index;
		/** Unquoted and lower-cased, as MySQL compares index names. */
		string normalizedIndex;
		/** USE, FORCE or IGNORE. */
		string action;
	}

	/**
	 * One block the normalizer collapsed: the first kept instance sits at
	 * [start, end) in the profile's query text and occurred count times in
	 * the original sample.
	 */
	record RepeatedBlock {
		int start;
		int end;
		int count;
	}

	/**
	 * One profile folded into the representative by normalized-digest
	 * merging: its own MySQL digest, the repeats it collapsed, and the
	 * metrics it contributed. Every member of a merge group normalizes to
	 * the same text, so these offsets index into the representative's query
	 * the same way its own repeatedBlocks do — only the counts differ.
	 */
	record MergedChild {
		string digest;
		array<RepeatedBlock> repeatedBlocks = [];
		long executed;
		@java-class("java.math.BigDecimal") string averageTime;
	}

	enum QueryActivityStatus {
		ACTIVE, DORMANT, UNKNOWN
	}

	record RuntimeMetrics {
		boolean fullTableScan;
		long executed;
		long errors;
		long warnings;
		@java-class("java.math.BigDecimal") string totalTime;
		@java-class("java.math.BigDecimal") string maxTime;
		@java-class("java.math.BigDecimal") string averageTime;
		long rowsSent;
		long averageRowsSent;
		long rowsScanned;
		long averageRowsScanned;
		long tempTables;
		long tempDiskTables;
		long rowsSorted;
		long sortMergePasses;
		string digest;
		local_timestamp_ms lastSeen;
		local_timestamp_ms firstSeen;
		@java-class("java.math.BigDecimal") string lockTime;
		long rowsAffected;
		long averageRowsAffected;
		array<string> digestList = [];
	}

	record ColumnReference {
		TableReference table;
		string column;
		string normalizedColumn;
	}

	record JoinColumns {
		ColumnReference left;
		ColumnReference right;
		/** INNER/LEFT/RIGHT/FULL/CROSS/STRAIGHT/IMPLICIT; null when unknown. */
		string? joinType = null;
	}

	record TableReference {
		string? schemaName;
		string tableName;
		string normalizedTableName;
		string? normalizedSchemaName;
	}

	/*
	 * A cluster's schema snapshot, one row per table (sqlx-7o3). Mirrors the
	 * loader's TableStructure and its parts; what the snapshot describes — its
	 * cluster, the server it was read from, when, and the fingerprint it was
	 * read at — is in the file's footer, as a capture's provenance is.
	 */
	record SnapshotColumn {
		string? schemaName = null;
		string? table = null;
		string columnName;
		/** java.sql.JDBCType name; null when the driver reported a code it has no name for. */
		string? jdbcType = null;
		string? typeName = null;
		int columnSize;
		int decimalDigits;
		int radix;
		string? remarks = null;
		string? columnDefault = null;
		int octetLength;
		int ordinal;
		string? isNullable = null;
		string? isAutoIncrement = null;
		string? isGenerated = null;
		string? characterSet = null;
		string? collation = null;
	}

	record SnapshotIndex {
		string? schemaName = null;
		boolean unique;
		string? identifier = null;
		string? name = null;
		/** IndexType name. */
		string? indexType = null;
		/** IndexDirection name. */
		string? direction = null;
		long cardinality;
		long pages;
		string? filterCondition = null;
		array<string> columns = [];
	}

	record SnapshotForeignKey {
		array<ColumnReference> from = [];
		array<ColumnReference> to = [];
		string? constraintName = null;
		string? onUpdate = null;
		string? onDelete = null;
	}

	record SnapshotViewColumn {
		string name;
		array<ColumnReference> sources = [];
		boolean computed;
	}

	/**
	 * One server's information_schema.TABLES row for a table, as of readAt
	 * (sqlx-n5j.2). Every figure is nullable: views have none, and a server
	 * may withhold any of them.
	 */
	record SnapshotTableStats {
		string server;
		/** Epoch millis of the read. */
		long readAt;
		/** TABLE_ROWS: an estimate for InnoDB, not a count. */
		long? rowsEstimate = null;
		long? dataLength = null;
		long? indexLength = null;
		long? dataFree = null;
		long? avgRowLength = null;
		long? autoIncrement = null;
		string? rowFormat = null;
		string? engine = null;
		/** Epoch millis. */
		long? createTime = null;
		/** Epoch millis. */
		long? updateTime = null;
		string? tableCollation = null;
	}

	record SnapshotTable {
		string? schemaName = null;
		string name;
		string? type = null;
		string? remarks = null;
		array<SnapshotForeignKey> foreignKeys = [];
		array<SnapshotIndex> indices = [];
		array<SnapshotColumn> columns = [];
		/** Base tables a view selects from; null for a base table. */
		union { null, array<TableReference> } underlyingTables = null;
		/** Per-column lineage for a view; null for a base table. */
		union { null, array<SnapshotViewColumn> } viewColumns = null;
		/**
		 * Size and row estimate from the server the snapshot was last
		 * refreshed from; null in snapshots written before sqlx-n5j.2.
		 */
		union { null, SnapshotTableStats } stats = null;
	}
}
